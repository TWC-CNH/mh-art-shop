# Kopieren nach .env (lokal) bzw. in Netlify unter Site configuration > Environment variables eintragen.

# Pflicht für echte Verkäufe (ohne Schlüssel läuft der Shop im Demo-Modus)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=https://shop.novaspes.de

# Atelier (Pflegeseite /atelier für Matthias)
ATELIER_PASSWORD=bitte-ein-langes-passwort
# ATELIER_SECRET=lange-zufaellige-zeichenkette   # ändern = alle Geräte abmelden

# Verschlüsselung personenbezogener Daten (Widerrufe mit Name/E-Mail), AES-256-GCM. Pflicht im Livebetrieb.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sicher aufbewahren (z. B. Passwortmanager): Geht der Schlüssel verloren, sind gespeicherte Widerrufe unlesbar.
# Wechsel: neuen Schlüssel hier eintragen, den bisherigen als DATA_ENCRYPTION_KEY_OLD.
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_OLD=

# E-Mail-Versand (Pflicht für den Widerrufsbutton nach § 356a BGB: Eingangsbestätigung an Käufer)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=anfragen@matthiashuebner.art
SMTP_PASS=...

# Versand (Euro je Formatklasse, längste Seite <60 / <100 / ab 100 cm)
SHIPPING_SMALL_EUR=29
SHIPPING_MEDIUM_EUR=49
SHIPPING_LARGE_EUR=89
SHIPPING_COUNTRIES=DE
PICKUP_ENABLED=true
DELIVERY_DAYS=3-7

# Steuer: true = Kleinunternehmer nach § 19 UStG (keine USt ausweisen)
KLEINUNTERNEHMER=true

# Optional
# STRIPE_TERMS_CONSENT=true        # Checkbox "AGB akzeptiert" im Checkout (vorher AGB-URL im Stripe-Dashboard hinterlegen)
# STRIPE_INVOICE_CREATION=true     # Stripe erzeugt automatisch eine Rechnung (kostet Stripe-Invoicing-Gebühr)
# SHOW_SOLD=true                   # verkaufte Werke als "Verkauft" weiter zeigen
# GOOGLE_TAG_ID=AW-123456789       # Google Ads Tag, lädt nur nach Einwilligung
# GOOGLE_ADS_CONVERSION=AW-123456789/AbCdEf   # Conversion-Label für Käufe

# Missbrauchsschutz (optional, Standardwerte reichen normalerweise)
# LIMIT_CHECKOUT_PER_IP=3                 # neue Bezahlvorgänge (= Reservierungen) je IP und Reservierungsdauer
# LIMIT_LOGIN_FAILS_PER_IP=10             # falsche Atelier-Passwörter je IP, danach Sperre
# LIMIT_LOGIN_WINDOW_MIN=15               # Dauer der Sperre in Minuten
# LIMIT_WITHDRAW_PER_IP=5                 # Widerrufe je IP und Stunde
# LIMIT_WITHDRAW_MAILS_PER_RECIPIENT=2    # Bestätigungsmails je E-Mail-Adresse und Tag
