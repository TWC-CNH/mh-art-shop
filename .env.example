# MH ART Shop – Konfiguration. Auf dem Server als .env im Projektordner (NICHT in public/), chmod 600.
# Kommentare mit # sind auch hinter einem Wert erlaubt (mit Leerzeichen davor). Enthält ein Wert selbst „ #“ oder beginnt er
# mit Leerzeichen (z. B. ein Passwort), ihn in Anführungszeichen setzen. Ein # direkt nach dem = gehört zum Wert.

SITE_URL=https://matthiashuebner.art
# APP_ENV=local                       # nur lokal: zeigt Fehler im Browser

# Datenbank (in konsoleH angelegt, Host meist localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Stripe (ohne Schlüssel: Shop zeigt die Werke, Kaufen ist gesperrt)
# Schlüssel aus dem Stripe-Dashboard (Testmodus: sk_test_…, live: sk_live_…). Leer lassen = Kaufen gesperrt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Atelier (/atelier): Benutzer mit Passwort und Authenticator-App werden per SSH angelegt:
#   php bin/atelier-user.php anlegen <name>

# Verschlüsselung personenbezogener Daten (Widerrufe, Anfragen). Pflicht.
# Erzeugen: php bin/generate-key.php – sicher aufbewahren (Passwortmanager)! Geht er verloren, sind die Daten unlesbar.
# Wechsel: neuen Schlüssel hier eintragen, den bisherigen als DATA_ENCRYPTION_KEY_OLD, dann
#   php bin/rotate-key.php   (verschlüsselt alles neu; danach darf DATA_ENCRYPTION_KEY_OLD wieder weg)
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_OLD=

# E-Mail über ein Postfach aus konsoleH (Pflicht für die Widerrufsbestätigung nach § 356a BGB)
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_USER=anfragen@matthiashuebner.art
SMTP_PASS=
# SMTP_FROM=anfragen@matthiashuebner.art
CONTACT_EMAIL=anfragen@matthiashuebner.art

# Protokolle und Sperrdateien außerhalb des Webroots (Server: absolute Pfade)
# LOG_DIR=/home/BENUTZER/logs
# RUN_DIR=/home/BENUTZER/run

# Versand (Euro je Formatklasse, längste Seite <60 / <100 / ab 100 cm)
SHIPPING_SMALL_EUR=29
SHIPPING_MEDIUM_EUR=49
SHIPPING_LARGE_EUR=89
SHIPPING_COUNTRIES=DE
PICKUP_ENABLED=true
DELIVERY_DAYS=3-7

# Steuer: true = Kleinunternehmer nach § 19 UStG (keine USt ausweisen)
KLEINUNTERNEHMER=true

# Aufbewahrung (Löschung per Cron)
# RETENTION_INQUIRY_MONTHS=12
# RETENTION_WITHDRAWAL_YEARS=3

# Missbrauchsschutz (Standardwerte reichen normalerweise)
# LIMIT_CHECKOUT_PER_IP=3                 # neue Bezahlvorgänge (= Reservierungen) je IP und Reservierungsdauer
# LIMIT_LOGIN_FAILS_PER_IP=10             # falsche Atelier-Passwörter je IP, danach Sperre
# LIMIT_LOGIN_WINDOW_MIN=15
# LIMIT_WITHDRAW_PER_IP=5                 # Widerrufe je IP und Stunde
# LIMIT_WITHDRAW_MAILS_PER_RECIPIENT=2    # Bestätigungsmails je E-Mail-Adresse und Tag
# LIMIT_INQUIRY_PER_IP=10                 # Anfragen je IP und Stunde
# TRUSTED_PROXIES=                        # nur falls ein Proxy vor Apache sitzt (dann X-Forwarded-For auswerten)

# Optional
# STRIPE_TERMS_CONSENT=true        # Checkbox "AGB akzeptiert" im Checkout (vorher AGB-URL im Stripe-Dashboard hinterlegen)
# STRIPE_INVOICE_CREATION=true     # Stripe erzeugt automatisch eine Rechnung (kostet Stripe-Invoicing-Gebühr)
# ALLOW_PROMOTION_CODES=true       # Gutscheincodes im Checkout
# SHOW_SOLD=true                   # verkaufte Werke als "Verkauft" weiter zeigen
# GOOGLE_TAG_ID=AW-123456789       # Google Ads Tag, lädt nur nach Einwilligung
# GOOGLE_ADS_CONVERSION=AW-123456789/AbCdEf

# Nur für Tests: eigene Testdatenbank (Standard mhart_shop_test mit denselben Zugangsdaten)
# TEST_DB_NAME=mhart_shop_test
