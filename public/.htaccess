# MH ART Shop – Apache (Hetzner). Dokumentenwurzel muss auf .../public zeigen.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS erzwingen
  # Kein Proxy vor Apache: X-Forwarded-Proto käme vom Besucher und darf den HTTPS-Zwang nicht aushebeln
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www auf die Hauptdomain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Vorhandene Dateien direkt ausliefern, alles andere an index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Versteckte Dateien (z. B. .htaccess, .user.ini) nie ausliefern
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Bilder (Logo, Icons, Werkfotos) können unter gleichem Namen ersetzt werden: einen Tag cachen
  <FilesMatch "\.(jpg|jpeg|webp|png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Uploads (eindeutige Namen) und Schriften ändern sich nie: dauerhaft cachen
  <If "%{REQUEST_URI} =~ m#^/(bilder|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
